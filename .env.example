# Salin file ini menjadi .env  (cp .env.example .env) lalu isi key-nya.
# .env TIDAK boleh di-commit ke Git — sudah masuk .gitignore.

# API key Meta AI / Llama API. Buat key di: https://www.llama.com/products/llama-api/
# Kosongkan saja kalau mau tes dulu dalam mode mock (tanpa key tetap bisa kirim-terima).
META_API_KEY=

# Endpoint API (format OpenAI-compatible). Default = Llama API resmi.
META_API_BASE_URL=https://api.llama.com/v1

# Model yang dipakai. Ganti sesuai yang tersedia di akunmu.
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Kepribadian asisten (system prompt) — ubah ini untuk memberi "kepala" Meta AI
# karakter badan buatanmu sendiri.
SYSTEM_PROMPT=Kamu adalah asisten berbahasa Indonesia yang membantu dengan singkat, jelas, dan ramah.

# Batas panjang 1 pesan dari aplikasi (karakter).
MAX_MESSAGE_CHARS=4000

# Port backend.
PORT=8000

# Paksa mode mock walau key terisi: isi true. Kosong/false = live bila key ada.
MOCK_MODE=

# Integrasi n8n (opsional) — URL webhook PRODUKSI workflow n8n yang menerima
# perintah dari Your Agent (skill kirim_ke_n8n). Kosong = integrasi mati.
# Contoh: https://n8n.example.com/webhook/your-agent
N8N_WEBHOOK_URL=

# Rahasia bersama n8n (opsional) — dikirim sebagai header X-Webhook-Secret
# agar workflow n8n bisa memastikan pengirimnya benar backend ini.
N8N_WEBHOOK_SECRET=

# Token aplikasi — WAJIB diisi sebelum backend di-deploy ke publik.
# Aplikasi Android harus mengirim header X-App-Token dengan nilai yang sama
# (diatur dari tombol URL di aplikasi). Isi dengan teks acak yang panjang.
# Kosong = tanpa proteksi (hanya aman untuk tes lokal).
APP_TOKEN=
