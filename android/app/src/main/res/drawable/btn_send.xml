<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol kirim: lingkaran gradasi cyan -> ungu -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#39406B" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#67E8F9"
                android:endColor="#A78BFA"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#22D3EE"
                android:endColor="#8B5CF6"
                android:type="linear" />
        </shape>
    </item>
</selector>
