<?xml version="1.0" encoding="utf-8"?>
<!-- Bubble agen: kartu gelap dengan garis tepi lembut, ekor kecil di kiri bawah -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A2138" />
    <stroke
        android:width="1dp"
        android:color="#2A3352" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="22dp" />
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp" />
</shape>
