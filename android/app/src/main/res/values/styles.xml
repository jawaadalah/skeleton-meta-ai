<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tombol chip outline kecil di header gradasi (URL / Hapus) -->
    <style name="Widget.YourAgent.ChipButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_chip_header</item>
        <item name="android:textColor">@color/text_on_gradient</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Tombol kirim bulat bergradasi -->
    <style name="Widget.YourAgent.SendButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/btn_send</item>
        <item name="android:textColor">@color/text_on_gradient</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <!-- Tema aplikasi v9: gelap premium, tanpa ActionBar (header gradasi kustom) -->
    <style name="Theme.YourAgent" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorAccent">@color/accent_violet</item>
        <item name="android:windowBackground">@color/bg_navy_deep</item>
        <item name="android:statusBarColor">@color/bg_navy_deep</item>
        <item name="android:navigationBarColor">@color/bg_navy_deep</item>
    </style>

    <!-- Kartu & field di layar Pengaturan (v11) -->
    <style name="Widget.YourAgent.SettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_agent_bar</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.YourAgent.SettingsTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.YourAgent.SettingsLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="Widget.YourAgent.SettingsHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.YourAgent.SettingsField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_edit_pill</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
